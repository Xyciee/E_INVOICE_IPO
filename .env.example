# Frontend container settings (docker-compose.yml). Copy to .env on the server. No secrets here.

# Port on BIO-SERVER where the app opens (8000 is used by other projects, 8002 is the backend API).
FRONTEND_PORT=8003

# The backend's Docker network: <backend folder name>_default. Check with: docker network ls
BACKEND_NETWORK=invoicing_backend_default

# Where nginx sends /api/ and /admin/: the backend's `web` service on that network.
# Alternative if the network name differs: the backend's address on the LAN, e.g. http://10.10.1.20:8002
BACKEND_URL=http://web:8000
